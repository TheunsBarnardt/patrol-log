# ai-fdl-kit
.fdl/cache/
*.proposed.blueprint.yaml

# dependencies
node_modules/
.pnpm-store/

# build artifacts
dist/
build/
.wrangler/
.vercel/
.next/
.expo/
.turbo/

# environment
.env
.env.*
!.env.example
.dev.vars

# editor
.idea/
# Keep shared VS Code launch/debug configs
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
*.swp
.DS_Store

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# native
apps/mobile/ios/build/
apps/mobile/android/build/
apps/mobile/android/.gradle/

# firebase credentials — never commit these
apps/mobile/google-services.json
apps/mobile/GoogleService-Info.plist
**/firebase-service-account*.json

# drizzle
apps/api/drizzle/meta/

# generated local seed SQL (regenerated by seed-local.mjs)
apps/api/src/db/_local-seed.sql
apps/api/src/db/_remote-seed.sql
