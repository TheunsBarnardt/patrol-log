{
  "name": "@patrol-log/mobile",
  "version": "0.2.25",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web --port 8082",
    "prebuild": "expo prebuild",
    "export:web": "expo export --platform web --clear",
    "deploy:web": "expo export --platform web --clear && wrangler pages deploy --project-name patrol-log-mobile --branch master --commit-dirty=true",
    "icons": "node scripts/generate-icons.mjs",
    "build:android:preview": "eas build -p android --profile preview",
    "build:android:prod": "eas build -p android --profile production"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.2.3",
    "@expo/vector-icons": "^14.0.0",
    "@patrol-log/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "expo": "~51.0.0",
    "expo-application": "~5.9.1",
    "expo-constants": "~16.0.1",
    "expo-keep-awake": "~13.0.2",
    "expo-linking": "~6.3.1",
    "expo-location": "~17.0.1",
    "expo-notifications": "~0.28.19",
    "expo-secure-store": "~13.0.1",
    "expo-status-bar": "~1.12.1",
    "expo-task-manager": "~11.8.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.1",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-maps": "1.14.0",
    "react-native-reanimated": "~3.10.0",
    "react-native-safe-area-context": "4.10.1",
    "react-native-screens": "3.31.1",
    "react-native-web": "~0.19.10",
    "react-native-webview": "~13.8.6",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.2.79",
    "typescript": "~5.4.5"
  }
}
