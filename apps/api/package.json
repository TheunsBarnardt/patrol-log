{
  "name": "@patrol-log/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0 --port 8787",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "db:generate": "drizzle-kit generate",
    "db:push": "wrangler d1 push patrol-log-db --local",
    "db:seed": "node src/db/seed-d1.mjs",
    "db:seed:remote": "node src/db/seed-remote.mjs",
    "db:sync:pull": "node src/db/sync-d1.mjs pull",
    "db:sync:push": "node src/db/sync-d1.mjs push",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/hashes": "^1.6.0",
    "@patrol-log/shared": "workspace:*",
    "drizzle-orm": "^0.30.10",
    "hono": "^4.4.0",
    "jose": "^5.2.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240512.0",
    "drizzle-kit": "^0.21.0",
    "miniflare": "^3.20240512.0",
    "typescript": "^5.4.5",
    "wrangler": "^3.57.0",
    "dotenv": "^16.4.5"
  }
}
